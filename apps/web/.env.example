# When true (default), pages read from mock fixtures in lib/api/*.ts instead of the real API.
# Flip to false module-by-module as each backend endpoint goes live (docs/ARCHITECTURE.md, Section 8).
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the Express API (apps/api). Only used once NEXT_PUBLIC_USE_MOCKS=false.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
